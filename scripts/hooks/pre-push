#!/bin/sh
# git pre-push hook: refuses a push whose files or commit messages hold one of your private terms
# (scripts/check_private_terms.py, the list YTBRAIN_PRIVATE_TERMS names). Install once:
#   ln -s ../../scripts/hooks/pre-push .git/hooks/pre-push
# `git push --no-verify` skips it.
cd "$(git rev-parse --show-toplevel)" || exit 1
PY="$(sh scripts/python.sh)"
exec "$PY" scripts/check_private_terms.py --pre-push
